// GLSL Hologram Shader
// VERTEX SHADER
#version 120
attribute vec4 vtx_position;
attribute vec3 vtx_normal;
uniform mat4 mat_modelview;
uniform mat4 mat_modelproject;

varying vec3 l_normal;
varying vec3 l_eye_vec;

void main() {
    gl_Position = mat_modelproject * vtx_position;
    l_normal = normalize(mat3(mat_modelview) * vtx_normal);
    l_eye_vec = normalize(-vec3(mat_modelview * vtx_position));
}

// ========================
// FRAGMENT SHADER
#version 120
varying vec3 l_normal;
varying vec3 l_eye_vec;

void main() {
    float fresnel = 1.0 - max(0.0, dot(l_normal, l_eye_vec));
    fresnel = pow(fresnel, 2.2);

    vec3 holo_cyan = vec3(0.0, 0.85, 1.0);
    float alpha = clamp(fresnel + 0.25, 0.15, 0.85);
    
    gl_FragColor = vec4(holo_cyan * (fresnel + 0.6), alpha);
}